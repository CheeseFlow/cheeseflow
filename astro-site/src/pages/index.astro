---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Intro Section -->
  <section class="intro bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 min-h-screen flex items-center justify-center text-white">
    <header class="text-center px-8">
      <span class="block mb-6">
        <img src="/images/cheeseflow-logo.svg" alt="CheeseFlow" class="w-32 h-32 mx-auto" />
      </span>
      <h1 class="text-5xl md:text-6xl font-bold font-['Montserrat'] mb-4">Cheese Flow</h1>
      <p class="text-xl md:text-2xl font-light mb-8">Based in Shenzhen</p>
      <ul class="flex justify-center">
        <li>
          <a href="#first" class="inline-block text-white hover:text-purple-300 transition-colors">
            <span class="text-4xl">↓</span>
          </a>
        </li>
      </ul>
    </header>
    <div class="absolute bottom-20 left-0 right-0 text-center">
      <h2 class="text-4xl md:text-6xl font-bold font-['Raleway'] leading-tight">
        Brand Look,<br />Personality,<br />&amp; Influence.
      </h2>
    </div>
  </section>

  <!-- Team Section -->
  <section id="first" class="py-20 px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12">
        <h2 class="text-4xl md:text-5xl font-bold font-['Montserrat'] text-gray-900 mb-4">We are creatives.</h2>
      </header>
      <div class="content">
        <section>
          <header class="mb-8">
            <h3 class="text-2xl md:text-3xl font-semibold font-['Montserrat'] text-gray-800 mb-2">Global team</h3>
            <p class="text-lg text-gray-600">Experts from all over the world.</p>
          </header>
          <div class="mb-8">
            <p class="text-lg text-gray-700 mb-8">
              <strong>International team based in Shenzhen.</strong> We specialize in creative brand strategy.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
              <img src="/images/team/Join.jpg" alt="Join us" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Gio.jpg" alt="Giovanni" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Jenxi.jpg" alt="Jenxi" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Matt.jpg" alt="Matt" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Mark.jpg" alt="Mark" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Momo.jpg" alt="Momo" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Monica.jpg" alt="Monica" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Felix.jpg" alt="Felix" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Diego.jpg" alt="Diego" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Guido.jpg" alt="Guido" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/James.jpg" alt="James" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Kiwi.jpg" alt="Kiwi" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Simone.jpg" alt="Simone" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Kimby.jpg" alt="Kimby" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Xiaobao.jpg" alt="Xiaobao" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
              <img src="/images/team/Join.jpg" alt="Join us" class="w-full h-auto rounded-lg shadow-md hover:shadow-xl transition-shadow" />
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section class="py-20 px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12">
        <h2 class="text-4xl md:text-5xl font-bold font-['Montserrat'] text-gray-900">Selected work.</h2>
      </header>
      <div class="content">
        <section class="mb-12">
          <header class="mb-8">
            <h3 class="text-2xl md:text-3xl font-semibold font-['Montserrat'] text-gray-800 mb-2">Quick overview</h3>
            <p class="text-lg text-gray-600 mb-6">Our work speak for itself. Here are some of our work.</p>
          </header>
          <div class="mb-8">
            <p class="text-lg text-gray-700 mb-6"><strong>Find out more.</strong> Drop us an email to learn more about our services.</p>
            <form method="post" action="https://formspree.io/mayplbre" class="max-w-2xl">
              <div class="grid md:grid-cols-2 gap-4 mb-4">
                <input
                  type="text"
                  name="name"
                  placeholder="Name"
                  class="px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-600"
                />
                <input
                  type="email"
                  name="_replyto"
                  placeholder="Email address"
                  class="px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-600"
                />
              </div>
              <select
                name="category"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-purple-600"
              >
                <option value="">- Select service type -</option>
                <option value="Identity">Brand identity &amp; logo</option>
                <option value="Video">Video production</option>
                <option value="Community">Community management</option>
              </select>
              <button
                type="submit"
                class="px-8 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors"
              >
                Send Message
              </button>
            </form>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Kranio Portfolio Section -->
  <section class="py-20 px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <header class="mb-8">
        <div class="flex justify-center mb-8">
          <img src="/images/gallery/fulls/kranio-side.png" alt="Kranio" class="max-w-md w-full" />
        </div>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <img src="/images/gallery/thumbs/kranio-hero.jpg" alt="Kranio lifestyle" class="w-full h-auto rounded-lg shadow-md lg:col-span-2" />
        <img src="/images/gallery/thumbs/kranio-logo.jpg" alt="Kranio logo" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/kranio-staff.jpg" alt="Kranio Kickstarter staff pick" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/kranio-unbox.jpg" alt="Kranio on Unbox Therapy" class="w-full h-auto rounded-lg shadow-md lg:col-span-4" />
      </div>
    </div>
  </section>

  <!-- Innway Portfolio Section -->
  <section class="py-20 px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <header class="mb-8">
        <div class="flex justify-center mb-8">
          <img src="/images/gallery/thumbs/innway-products.png" alt="Innway" class="max-w-md w-full" />
        </div>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <img src="/images/gallery/thumbs/innway-find.gif" alt="Find what you want with Innway" class="w-full h-auto rounded-lg shadow-md lg:col-span-2" />
        <img src="/images/gallery/thumbs/innway-accent.jpg" alt="Innway accent" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/innway-tag.jpg" alt="Innway Tag lifestyle" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/innway-logo.jpg" alt="Innway logo" class="w-full h-auto rounded-lg shadow-md lg:col-span-4" />
      </div>
    </div>
  </section>

  <!-- Thinkdiag Portfolio Section -->
  <section class="py-20 px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <header class="mb-8">
        <div class="flex justify-center mb-8">
          <img src="/images/gallery/thumbs/thinkdiag.png" alt="Thinkdiag" class="max-w-md w-full" />
        </div>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <img src="/images/gallery/thumbs/thinkdiag-lifestyle.jpg" alt="Thinkdiag lifestyle" class="w-full h-auto rounded-lg shadow-md lg:col-span-2" />
        <img src="/images/gallery/thumbs/thinkdiag-graphic.jpg" alt="THINKDIAG Kickstarter graphic" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/thinkdiag-social.jpg" alt="THINKDIAG social media" class="w-full h-auto rounded-lg shadow-md" />
        <img src="/images/gallery/thumbs/thinkdiag-usage.jpg" alt="THINKDIAG lifestyle" class="w-full h-auto rounded-lg shadow-md lg:col-span-4" />
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 px-8 bg-gradient-to-br from-purple-900 to-indigo-900 text-white">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold font-['Montserrat'] mb-4">We grow brands.</h2>
      </header>
      <div class="content">
        <section>
          <header class="mb-8 text-center">
            <h3 class="text-2xl md:text-3xl font-semibold font-['Montserrat'] mb-2">Empowering brands</h3>
            <p class="text-lg">We grow your brands on the international stage</p>
          </header>
          <div class="text-center">
            <p class="text-lg mb-12"><strong>Three types of services.</strong> We help your brand flourish through these areas.</p>
            <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
              <img src="/images/brand-look.svg" class="w-32 h-32 mx-auto" alt="Brand Look" />
              <img src="/images/brand-personality.svg" class="w-32 h-32 mx-auto" alt="Brand Personality" />
              <img src="/images/brand-influence.svg" class="w-32 h-32 mx-auto" alt="Brand Influence" />
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 px-8 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12">
        <h2 class="text-4xl md:text-5xl font-bold font-['Montserrat']">Let's talk</h2>
      </header>
      <div class="content">
        <p class="text-lg mb-8"><strong>Get in touch.</strong> We love to hear from you.</p>
        <form action="https://formspree.io/mwkrwqdd" method="POST" class="max-w-2xl mb-12">
          <div class="grid md:grid-cols-2 gap-4 mb-4">
            <input
              type="text"
              name="name"
              placeholder="Name"
              class="px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-purple-600"
            />
            <input
              type="email"
              name="_replyto"
              placeholder="Email"
              class="px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-purple-600"
            />
          </div>
          <textarea
            name="message"
            placeholder="Message"
            rows="7"
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white mb-4 focus:outline-none focus:ring-2 focus:ring-purple-600"
          ></textarea>
          <button
            type="submit"
            class="px-8 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors"
          >
            Send Message
          </button>
        </form>

        <footer class="grid md:grid-cols-3 gap-8 py-12 border-t border-gray-700">
          <div>
            <h3 class="text-xl font-semibold font-['Montserrat'] mb-3">Email</h3>
            <span class="text-gray-300">hey [at] cheeseflow [dot] com</span>
          </div>
          <div>
            <h3 class="text-xl font-semibold font-['Montserrat'] mb-3">Address</h3>
            <span class="text-gray-300">
              208-212, Block A2, iMakerbase<br />
              Hangcheng Innovation Venture Park, Hangcheng Road<br />
              Bao'an District, Shenzhen, Guangdong, China
            </span>
          </div>
          <div>
            <h3 class="text-xl font-semibold font-['Montserrat'] mb-3">Connect</h3>
            <ul class="flex gap-4">
              <li>
                <a href="https://www.twitter.com/theCheeseFlow/" class="text-white hover:text-purple-400 transition-colors">
                  <span class="sr-only">Twitter</span>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path></svg>
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/CheeseFlow/" class="text-white hover:text-purple-400 transition-colors">
                  <span class="sr-only">Facebook</span>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
                </a>
              </li>
              <li>
                <a href="https://www.instagram.com/thecheeseflow/" class="text-white hover:text-purple-400 transition-colors">
                  <span class="sr-only">Instagram</span>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"></path></svg>
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/company/cheeseflow/" class="text-white hover:text-purple-400 transition-colors">
                  <span class="sr-only">LinkedIn</span>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path><circle cx="4" cy="4" r="2"></circle></svg>
                </a>
              </li>
            </ul>
          </div>
        </footer>

        <div class="text-center text-gray-400 pt-8 border-t border-gray-700">
          &copy; 2021 CheeseFlow. All rights reserved. <a href="https://cheeseflow.cn/" class="hover:text-purple-400 transition-colors">中文网站</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import wechatQRCode from "../assets/images/wechat-qr-code.jpg";

const currentYear = new Date().getFullYear();
---

<!-- Let's create delight with your brand Section -->
<section id="contact" class="py-48 px-6 bg-brand">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="text-right">
        <h2 class="text-7xl md:text-8xl font-body font-black text-ink">
          让您的品牌<br />带来喜悦
        </h2>
      </div>
      <div>
        <form
          action="/api/contact"
          method="POST"
          class="space-y-6"
        >
          <input type="hidden" name="locale" value="zh" />
          <div>
            <label for="name" class="sr-only">名字</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="名字"
              required
              class="w-full px-4 py-3 border border-grey rounded-lg focus:outline-none focus:ring-2 focus:ring-ink bg-white"
            />
          </div>
          <div>
            <label for="email" class="sr-only">邮箱地址</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="邮箱地址"
              required
              class="w-full px-4 py-3 border border-grey rounded-lg focus:outline-none focus:ring-2 focus:ring-ink bg-white"
            />
          </div>
          <div>
            <label for="message" class="sr-only">信息</label>
            <textarea
              id="message"
              name="message"
              placeholder="信息"
              rows="6"
              required
              class="w-full px-4 py-3 border border-grey rounded-lg focus:outline-none focus:ring-2 focus:ring-ink bg-white"
            ></textarea>
          </div>
          <button
            type="submit"
            class="text-lg w-full md:w-auto px-6 py-4 bg-ink text-white rounded-lg hover:bg-white hover:text-ink transition-colors"
          >
            提交
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<footer class="pt-48 pb-8 bg-ink text-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-start justify-between gap-6 mb-8">
      <h2 class="text-white text-7xl font-body font-black">芝士就是力量</h2>
      <img
        src={wechatQRCode.src}
        alt="WeChat QR Code"
        class="w-32 h-32 rounded-2xl flex-shrink-0"
      />
    </div>

    <div class="flex flex-wrap gap-6 text-sm text-white mb-8">
      <a href="#services" class="hover:text-brand transition-colors">服务</a>
      <a href="#contact" class="hover:text-brand transition-colors">联系</a>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-6 text-sm">
      <p class="text-white">
        © 2019-{currentYear} CheeseFlow <span
          >芝士溪谷</span
        > · <a href="https://rubycoded.cn" class="text-white hover:text-brand transition-colors">鲁比克（深圳）科技有限公司</a> ·
        <a
          href="https://beian.miit.gov.cn/"

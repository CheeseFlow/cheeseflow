---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
}

const {
  title,
  description,
  image,
  canonical,
  type = 'website',
  publishedTime,
} = Astro.props;

const EN_ORIGIN = 'https://cheeseflow.com';
const ZH_ORIGIN = 'https://cheeseflow.cn';

const pathname = Astro.url?.pathname || '/';
const isZh = pathname.startsWith('/zh');
const siteOrigin = isZh ? ZH_ORIGIN : EN_ORIGIN;

const imagePath = image || '/og-default.jpg';
const imageUrl = imagePath.startsWith('http')
  ? imagePath
  : `${siteOrigin}${imagePath.startsWith('/') ? imagePath : `/${imagePath}`}`;

const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${siteOrigin}${canonical}`
  : `${siteOrigin}${pathname}`;

// Hreflang: en on .com, zh on .cn
const enPath = pathname.startsWith('/zh')
  ? pathname.replace(/^\/zh/, '/en')
  : pathname.startsWith('/en')
    ? pathname
    : '/en/';
const zhPath = pathname.startsWith('/en')
  ? pathname.replace(/^\/en/, '/zh')
  : pathname.startsWith('/zh')
    ? pathname
    : '/zh/';
const showHreflang = pathname.startsWith('/en') || pathname.startsWith('/zh');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Jenxi Seow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
{publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:creator" content="@jenxi" />
<meta name="twitter:site" content="@jenxi" />

<!-- Hreflang for language variants (en on .com, zh on .cn) -->
{showHreflang && (
  <>
    <link rel="alternate" hreflang="en" href={`${EN_ORIGIN}${enPath}`} />
    <link rel="alternate" hreflang="zh" href={`${ZH_ORIGIN}${zhPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${EN_ORIGIN}${enPath}`} />
  </>
)}

---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
}

const {
  title,
  description,
  image,
  canonical,
  type = 'website',
  publishedTime,
} = Astro.props;

const siteUrl = Astro.url?.origin || 'https://cheeseflow.com';
const imageUrl = image || '/og-default.jpg';
const pathname = Astro.url?.pathname || '/';
const canonicalUrl = canonical || `${siteUrl}${pathname}`;

// Hreflang: alternate en/zh for bilingual pages
const enPath = pathname.startsWith('/zh') ? pathname.replace(/^\/zh/, '/en') : pathname.startsWith('/en') ? pathname : '/en/';
const zhPath = pathname.startsWith('/en') ? pathname.replace(/^\/en/, '/zh') : pathname.startsWith('/zh') ? pathname : '/zh/';
const showHreflang = pathname.startsWith('/en') || pathname.startsWith('/zh');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Jenxi Seow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={`${siteUrl}${pathname}`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${siteUrl}${imageUrl}`} />
{publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={`${siteUrl}${pathname}`} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${imageUrl}`} />
<meta name="twitter:creator" content="@jenxi" />
<meta name="twitter:site" content="@jenxi" />

<!-- Hreflang for language variants (en/zh) -->
{showHreflang && (
  <>
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="zh" href={`${siteUrl}${zhPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${enPath}`} />
  </>
)}


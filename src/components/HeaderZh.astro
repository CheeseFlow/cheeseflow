---
import cheeseflowLogo from "../assets/cheeseflow-logo.svg";

interface Props {
  noBorder?: boolean;
}

const { noBorder = false } = Astro.props;
---

<header
  class={`fixed top-0 left-0 right-0 z-50 bg-brand ${noBorder ? '' : 'border-b border-ink/10'}`}
>
  <nav class="max-w-7xl mx-auto px-6 py-8 flex items-center justify-between">
    <div class="flex items-center">
      <a
        href="/zh"
        class="flex items-center"
        aria-label="CheeseFlow 芝士溪谷 - 首页"
      >
        <img
          src={cheeseflowLogo.src}
          alt="CheeseFlow 芝士溪谷"
          class="h-12 w-auto"
        />
      </a>
    </div>
    <div class="flex items-center gap-10">
      <a
        href="/zh/blog"
        class="text-lg text-ink px-4 py-2 rounded-lg hover:bg-white/20 transition-colors"
        >改良您的品牌</a
      >
      <a
        href="#contact"
        class="text-lg !px-6 !py-4 bg-ink text-white rounded-lg hover:bg-white hover:text-ink transition-colors"
        >联系我们</a
      >
    </div>
  </nav>
</header>



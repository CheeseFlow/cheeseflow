---
import SEO from "../components/SEO.astro";
import '../style/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "CheeseFlow 芝士溪谷 - Improve Your Brand",
  description = "Cinematic commercials. Captivating content. Creative copywriting. Cheese community. Choose CheeseFlow.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <SEO title={title} description={description} canonical={canonical} />

    <link rel="alternate" type="application/rss+xml" title="CheeseFlow Blog (English)" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="CheeseFlow 博客" href="/feed-zh.xml" />

    <meta name="baidu-site-verification" content="code-dR69D2yODd" />

    <!-- Adobe Typekit (CSS kit only — avoid dual CSS + JS loaders) -->
    <link rel="stylesheet" href="https://use.typekit.net/zik7fnh.css" />
    <script is:inline defer src="https://analytics.rubycoded.com/script.js" data-website-id="7ed75f9a-2ee3-4b13-8bbf-775f35aa8f52"></script>
    <slot name="head" />
  </head>
  <body class="font-body">
    <slot />
  </body>
</html>

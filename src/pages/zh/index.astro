---
import BaseLayout from "../../layouts/BaseLayoutZh.astro";
import TypingHero from "../../components/TypingHero.astro";
import Header from "../../components/HeaderZh.astro";
import Footer from "../../components/FooterZh.astro";
import muzenImage from "../../assets/images/muzen-case.webp";
import clientsImage from "../../assets/images/CheeseFlow-clients-CN.webp";
import brandLookImage from "../../assets/images/brand-look.png";
import brandPersonalityImage from "../../assets/images/brand-personality.png";
import brandInfluenceImage from "../../assets/images/brand-influence.png";
import botonCaseImage from "../../assets/images/boton-case.png";
import botonLogo from "../../assets/clients/boton.svg";
import yadeaCaseImage from "../../assets/images/yadea-case.png";
import yadeaLogo from "../../assets/clients/yadea.svg";
import muzenCaseImage from "../../assets/images/muzen-case.webp";
import muzenLogo from "../../assets/clients/muzen.svg";
import meadjohnsonCaseImage from "../../assets/images/meadjohnson-case.png";
import meadjohnsonLogo from "../../assets/clients/meadjohnson.svg";
import yeelightCaseImage from "../../assets/images/yeelight-case.png";
import yeelightLogo from "../../assets/clients/yeelight.svg";
import kranioCaseImage from "../../assets/images/kranio-case.png";

---

<BaseLayout>
  <Header />

  <!-- Hero Section -->
  <section
    class="h-[50vh] md:min-h-screen flex flex-col items-center justify-center px-6 pt-24 pb-12 relative bg-white overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat grayscale"
      style={`background-image: url(${muzenImage.src})`}
    >
    </div>
    <div class="absolute inset-0 bg-white/70"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <TypingHero client:load />
      <p class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl text-ink font-black mt-8">
        通过国际视角带来优质品牌出海
      </p>
      <p class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl text-ink mt-4">
        创意 + 战略 = 品牌
      </p>
    </div>
  </section>

  <!-- Creativity + Strategy Section -->
  <section class="py-24 md:py-48 px-12 md:px-16 bg-brand">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl text-ink font-black mb-8 leading-tight md:!leading-tight">
        "您的品牌不是由您所说的，<br />而是他人所说的"
      </p>
      <p class="text-lg md:text-2xl text-ink font-black mt-4">—马蒂·诺伊迈尔</p>
      <p class="text-lg md:text-2xl text-ink font-black mt-16">
        好品牌愉悦用户，令他们赞不绝口
      </p>
    </div>
  </section>

  <!-- Delight with your brand Section -->
  <section class="py-24 md:py-48 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-end">
        <div class="text-left md:text-right">
          <h2 class="text-6xl md:text-7xl font-black text-ink">
            让您的品牌<br />带来喜悦
          </h2>
        </div>
        <div>
          <p class="text-lg text-ink mb-6 leading-loose">
            芝士溪谷工作室，鲁比克（深圳）科技有限公司是个坐标深圳的品牌出海团队，致力于帮助国内企业提升在海外市场的竞争力
          </p>
          <p class="text-lg text-ink leading-loose">
            身为个多元化、国际化团队，我们通过对国外文化习俗的了解创建适合海外市场的品牌
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-12 mt-8">
        <div></div>
        <div class="flex gap-4">
          <a
            href="#services"
            class="text-lg !px-6 !py-4 bg-ink text-white rounded-lg hover:bg-white hover:text-ink transition-colors"
            >了解更多</a
          >
          <a
            href="#contact"
            class="text-lg !px-6 !py-4 border-2 border-ink text-ink rounded-lg hover:bg-ink hover:text-white transition-colors"
            >联系我们</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logo Showcase Section -->
  <section class="py-24 md:py-48 px-6 bg-grey">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-center">
        <img src={clientsImage.src} alt="Our Clients" class="w-full h-auto" />
      </div>
    </div>
  </section>

  <!-- Our Services Section -->
  <section id="services" class="pt-24 md:pt-60 pb-12 md:pb-24 px-6 md:px-6 bg-brand">
    <div class="max-w-7xl mx-auto">
      <header class="text-center mb-16 md:mb-32">
        <h2 class="text-4xl sm:text-5xl md:text-7xl font-heading font-black text-ink uppercase mb-4">
          服务介绍
        </h2>
        <p class="text-xl text-ink/70 mt-12">
          我们提供的服务可以分为三大类
        </p>
      </header>

      <!-- Service Categories -->
      <div class="grid md:grid-cols-3 gap-12 md:gap-8 mx-6 mb-24 md:mb-48">
        <a href="#brand-look" class="group mb-0">
          <img
            src={brandLookImage.src}
            alt="Look"
            class="w-full aspect-square mb-8 md:mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-black text-ink mb-0 md:mb-2 text-center md:text-left group-hover:text-ink transition-colors">品牌外观</h3>
        </a>
        <a href="#brand-personality" class="group mb-0">
          <img
            src={brandPersonalityImage.src}
            alt="Personality"
            class="w-full aspect-square mb-8 md:mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-black text-ink mb-0 md:mb-2 text-center md:text-left group-hover:text-ink transition-colors">
            品牌个性
          </h3>
        </a>
        <a href="#brand-influence" class="group mb-0">
          <img
            src={brandInfluenceImage.src}
            alt="Influence"
            class="w-full aspect-square mb-8 md:mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-black text-ink mb-0 md:mb-2 text-center md:text-left group-hover:text-ink transition-colors">
            品牌影响力
          </h3>
        </a>
      </div>
    </div>

    <!-- Brand Look Details -->
    <div id="brand-look" class="mb-20 scroll-mt-32">
      <div class="bg-white rounded-none md:rounded-2xl mb-8 overflow-hidden -mx-6 md:mx-6 md:max-w-7xl md:mx-auto">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandLookImage.src}
              alt="Brand Look"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-black text-ink mb-2 text-center md:text-left">品牌外观</h3>
            <p class="text-xl text-ink mb-8 text-center md:text-left">他人所看到的</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">品牌识别</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">品牌名字</li>
                    <li class="py-3 border-b border-grey text-ink">Logo 设计</li>
                    <li class="py-3 border-b border-grey text-ink">品牌指引</li>
                    <li class="py-3 border-b border-grey text-ink">VI 设计</li>
                    <li class="py-3 border-b border-grey text-ink">UI/UX 设计</li>
                    <li class="py-3 text-ink">IP 设计</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">视觉素材</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">照片摄影</li>
                    <li class="py-3 border-b border-grey text-ink">视频制作</li>
                    <li class="py-3 border-b border-grey text-ink">三维动画</li>
                    <li class="py-3 border-b border-grey text-ink">平面设计</li>
                    <li class="py-3 border-b border-grey text-ink">网站设计</li>
                    <li class="py-3 text-ink">包装设计</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Boton Case Study -->
      <div class="max-w-7xl mx-auto pt-24 md:pt-48 px-6 md:px-12 lg:px-16">
        <div class="grid md:grid-cols-2 gap-16 mb-8">
          <div class="md:col-span-1">
            <img
              src={botonCaseImage.src}
              alt="Boton Case Study"
              class="w-full h-auto rounded-2xl"
            />
          </div>
          <div class="md:col-span-1">
            <div class="mb-6 flex justify-center md:justify-start">
              <img
                src={botonLogo.src}
                alt="Boton"
                class="h-12 md:h-20 w-auto mb-6"
              />
            </div>
            <h4 class="text-3xl font-black text-ink uppercase mb-6">
              品牌名字、LOGO和 VI 设计
            </h4>
            <p class="text-xl text-ink mb-8 leading-relaxed">
              波顿集团是中国香精香料行业首家在港上市，也是在国内最大的香精香料企业。我们设计了集团孵化的新电子烟品牌，提供的服务包括为品牌取名、logo 设计、品牌视觉设计和品牌指引。
            </p>
            <div>
              <p class="text-xl font-semibold text-ink mb-6">我们所做的工作：</p>
              <ul class="space-y-3 text-xl text-ink leading-relaxed list-disc list-inside">
                <li>在品牌的行业里展开市场调研</li>
                <li>和您一起更深入了解您的品牌</li>
                <li>定义品牌理念、使命、愿景和价值</li>
                <li>
                  找出品牌定位、受众和竞争对手
                </li>
                <li>创建品牌的核心信息和故事</li>
                <li>设计三个品牌名字和 logo 设计大方向</li>
                <li>和您分析这三个方向来选出最佳方案</li>
                <li>
                  以所选方向为基础输出三个设计
                </li>
                <li>您来选择最终的名字和 logo 设计</li>
                <li>在最终方案上进行微调整后输出 VI 设计</li>
                <li>
                  设计品牌视觉风格并且定义品牌指引
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Yadea Case Study -->
  <section class="bg-white py-24 md:py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
          <div class="md:col-span-1">
            <img
              src={yadeaCaseImage.src}
              alt="Yadea Case Study"
              class="w-full h-auto rounded-2xl"
            />
          </div>
          <div class="md:col-span-1">
            <div class="mb-6 flex justify-center md:justify-start">
              <img
                src={yadeaLogo.src}
                alt="Yadea"
                class="h-12 md:h-20 w-auto mb-6"
              />
            </div>
            <h4 class="text-3xl font-black text-ink uppercase mb-6">
              视频制作和照片拍摄
            </h4>
            <p class="text-xl text-ink mb-8 leading-relaxed">
              雅迪是国内最大的电动车品牌，也是全球排名第二的电动车制造商。我们为首款电动滑板车拍摄新品发布和电商平台用的产品宣传片。
            </p>
            <div>
              <p class="text-xl font-semibold text-ink mb-6">我们所做的工作：</p>
              <ul class="space-y-3 text-xl text-ink leading-relaxed list-disc list-inside">
                <li>国际化视频风格和审美</li>
                <li>
                  输出视频创意和分镜脚本
                </li>
                <li>专业制作团队包括制片组、摄像组、灯光组和美术道具组</li>
                <li>意大利米兰和深圳当地都有视频制作团队</li>
                <li>按需求制造定制道具</li>
                <li>6K 和 8K 高清视频拍摄</li>
                <li>意大利三维动画渲染</li>
                <li>丰富国际演员和模特资源</li>
                <li>专业地道的配音师</li>
              </ul>
            </div>
          </div>
        </div>
  </section>

  <!-- Brand Personality Details -->
  <section id="services" class="pt-60 pb-24 px-6 md:px-6 bg-brand">
    <div class="max-w-7xl mx-auto">
      <div id="brand-personality" class="mb-20 scroll-mt-32">
        <div class="bg-white rounded-none md:rounded-2xl mb-8 overflow-hidden -mx-6 md:mx-6 md:max-w-7xl md:mx-auto">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandPersonalityImage.src}
              alt="Brand Personality"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-black text-ink mb-2 text-center md:text-left">
              品牌个性
            </h3>
            <p class="text-xl text-ink mb-8 text-center md:text-left">他人所感觉到的</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">品牌格调</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">品牌故事</li>
                    <li class="py-3 border-b border-grey text-ink">品牌人格</li>
                    <li class="py-3 border-b border-grey text-ink">社交媒体运营</li>
                    <li class="py-3 border-b border-grey text-ink">英文文案</li>
                    <li class="py-3 text-ink">活动策划</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">品牌互动</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">服务战略</li>
                    <li class="py-3 border-b border-grey text-ink">社区管理</li>
                    <li class="py-3 border-b border-grey text-ink">客服运营</li>
                    <li class="py-3 border-b border-grey text-ink">售后服务</li>
                    <li class="py-3 text-ink">媒介管理</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Muzen Audio Case Study -->
  <section class="bg-white py-24 md:py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={muzenCaseImage.src}
          alt="Muzen Audio Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <div class="mb-6 flex justify-center md:justify-start">
          <img
            src={muzenLogo.src}
            alt="Muzen Audio"
            class="h-12 md:h-20 w-auto mb-6"
          />
        </div>
        <h4 class="text-3xl font-black text-ink uppercase mb-6">
          微缩景视频制作和照片拍摄
        </h4>
        <p class="text-xl text-ink mb-8 leading-relaxed">
          猫王音响是个人文科技音响品牌，专注设计复古的时尚音响。我们在多个品牌摄影项目提供微缩景制作和拍摄。就如猫王通过产品设计来尝试各种视觉主题，我们也为对应的风格搭建奇幻微缩景模型。
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">我们所做的工作：</p>
          <ul class="space-y-3 text-xl text-ink leading-relaxed list-disc list-inside">
            <li>摄影创意概念和方案</li>
            <li>手工搭建仿真微缩景</li>
            <li>制造精致的微型道具</li>
            <li>
              微缩景拍摄效果比三维渲染看起来更加真实
            </li>
            <li>
              确保视觉风格符合品牌和活动向
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mead Johnson Case Study -->
  <section class="bg-brand py-24 md:py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={meadjohnsonCaseImage.src}
          alt="Mead Johnson Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <div class="mb-6 flex justify-center md:justify-start">
          <img
            src={meadjohnsonLogo.src}
            alt="Mead Johnson"
            class="h-12 md:h-20 w-auto mb-6"
          />
        </div>
        <h4 class="text-3xl font-black text-ink uppercase mb-6">
          品牌照片拍摄
        </h4>
        <p class="text-xl text-ink mb-8 leading-relaxed">
          美赞成是全球领先的婴儿奶粉品牌。我们为国内的婴儿奶粉产品线拍摄了高清品牌照片
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">我们所做的工作：</p>
          <ul class="space-y-3 text-xl text-ink leading-relaxed list-disc list-inside">
            <li>按品牌指引设计摄影创意概念和方案</li>
            <li>定下最终拍摄的视觉风格</li>
            <li>筛选符合品牌形象的模特名单</li>
            <li>设计化妆和造型风格</li>
            <li>准备布景所需要的道具</li>
            <li>
              拍摄修图后交付高清精修照片
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

    <!-- Brand Influence Details -->
    <section id="services" class="pt-60 pb-24 px-6 md:px-6 bg-brand">
      <div class="max-w-7xl mx-auto">
        <div id="brand-influence" class="mb-20 scroll-mt-32">
          <div class="bg-white rounded-none md:rounded-2xl mb-8 overflow-hidden -mx-6 md:mx-6 md:max-w-7xl md:mx-auto">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandInfluenceImage.src}
              alt="Brand Influence"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-black text-ink mb-2 text-center md:text-left">
              品牌影响力
            </h3>
            <p class="text-xl text-ink mb-8 text-center md:text-left">他人所说的</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">网络营销</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">搜索引擎优化 SEO</li>
                    <li class="py-3 border-b border-grey text-ink">社交媒体运营</li>
                    <li class="py-3 border-b border-grey text-ink">邮件营销</li>
                    <li class="py-3 border-b border-grey text-ink">广告投放</li>
                    <li class="py-3 text-ink">海外众筹</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">公关传媒</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">关键意见领袖 KOL 文章</li>
                    <li class="py-3 border-b border-grey text-ink">权威内容</li>
                    <li class="py-3 border-b border-grey text-ink">品牌推荐大使</li>
                    <li class="py-3 border-b border-grey text-ink">网红营销</li>
                    <li class="py-3 text-ink">媒体公关</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yeelight Case Study -->
  <section class="bg-brand py-24 md:py-48">

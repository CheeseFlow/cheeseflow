---
import BaseLayout from "../layouts/BaseLayout.astro";
import TypingHero from "../components/TypingHero.astro";
import cheeseflowLogo from "../assets/cheeseflow-logo.svg";
import muzenImage from "../assets/images/muzen-case.webp";
import clientsImage from "../assets/images/CheeseFlow-clients.webp";
import brandLookImage from "../assets/images/brand-look.png";
import brandPersonalityImage from "../assets/images/brand-personality.png";
import brandInfluenceImage from "../assets/images/brand-influence.png";
import botonCaseImage from "../assets/images/boton-case.png";
import botonLogo from "../assets/clients/boton.svg";
import yadeaCaseImage from "../assets/images/yadea-case.png";
import yadeaLogo from "../assets/clients/yadea.svg";
import muzenCaseImage from "../assets/images/muzen-case.webp";
import muzenLogo from "../assets/clients/muzen.svg";
import meadjohnsonCaseImage from "../assets/images/meadjohnson-case.png";
import meadjohnsonLogo from "../assets/clients/meadjohnson.svg";
import yeelightCaseImage from "../assets/images/yeelight-case.png";
import yeelightLogo from "../assets/clients/yeelight.svg";
import kranioCaseImage from "../assets/images/kranio-case.png";

const currentYear = new Date().getFullYear();
---

<BaseLayout>
  <!-- Header Navigation -->
  <header
    class="fixed top-0 left-0 right-0 z-50 bg-brand border-b border-ink/10"
  >
    <nav class="max-w-7xl mx-auto px-6 py-8 flex items-center justify-between">
      <div class="flex items-center">
        <a
          href="/"
          class="flex items-center"
          aria-label="CheeseFlow 芝士溪谷 - Home"
        >
          <img
            src={cheeseflowLogo.src}
            alt="CheeseFlow 芝士溪谷"
            class="h-12 w-auto"
          />
        </a>
      </div>
      <div class="flex items-center gap-10">
        <a
          href="#services"
          class="text-lg text-ink/80 hover:text-ink transition-colors"
          href="/blog"
          >Improve your brand</a
        >
        <a
          href="#contact"
          class="text-lg !px-6 !py-4 bg-ink text-white rounded-lg hover:bg-white hover:text-ink transition-colors"
          >Contact us</a
        >
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section
    class="min-h-screen flex flex-col items-center justify-center px-6 pt-24 pb-12 relative bg-white overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat grayscale"
      style={`background-image: url(${muzenImage.src})`}
    >
    </div>
    <div class="absolute inset-0 bg-white/70"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <TypingHero client:load />
      <p class="text-5xl md:text-6xl text-ink/70 mt-8">
        Creativity + Strategy = Brand
      </p>
    </div>
  </section>

  <!-- Creativity + Strategy Section -->
  <section class="py-48 px-12 md:px-16 bg-brand">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-6xl md:text-7xl text-ink/80 font-bold mb-8 !leading-tight">
        "Your brand isn't what you say it is.<wbr />It's what they say it is."
      </p>
      <p class="text-2xl text-ink/80 font-bold mt-4">—Marty Neumeier</p>
      <p class="text-2xl text-ink/80 font-bold mt-16">
        Good brands delight them so they would say good things.
      </p>
    </div>
  </section>

  <!-- Delight with your brand Section -->
  <section class="py-48 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-end">
        <div class="text-right">
          <h2 class="text-7xl md:text-8xl font-body font-bold text-ink">
            Delight<br />with your<br />brand.
          </h2>
        </div>
        <div>
          <p class="text-xl text-ink/80 mb-6 leading-loose">
            CheeseFlow is a Shenzhen-based creative studio that works with
            Chinese companies to increase their global market advantage.
          </p>
          <p class="text-xl text-ink/80 leading-loose">
            Our diverse, globalised team gives us an advantage to help clients
            build and grow their brands for the international market.
          </p>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-12 mt-8">
        <div></div>
        <div class="flex gap-4">
          <a
            href="#services"
            class="text-lg !px-6 !py-4 bg-ink text-white rounded-lg hover:bg-white hover:text-ink transition-colors"
            >Learn more</a
          >
          <a
            href="#contact"
            class="text-lg !px-6 !py-4 border-2 border-ink text-ink rounded-lg hover:bg-ink hover:text-white transition-colors"
            >Contact us</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logo Showcase Section -->
  <section class="py-48 px-6 bg-grey">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-center">
        <img src={clientsImage.src} alt="Our Clients" class="w-full h-auto" />
      </div>
    </div>
  </section>

  <!-- Our Services Section -->
  <section id="services" class="pt-60 pb-24 px-6 bg-brand">
    <div class="max-w-7xl mx-auto">
      <header class="text-center mb-32">
        <h2 class="text-xl md:text-7xl font-heading font-bold text-ink uppercase mb-4">
          Our Services
        </h2>
        <p class="text-xl text-ink/70 mt-12">
          The services we offer fall into three broad categories.
        </p>
      </header>

      <!-- Service Categories -->
      <div class="grid md:grid-cols-3 gap-8 mx-6 mb-48">
        <a href="#brand-look" class="group">
          <img
            src={brandLookImage.src}
            alt="Look"
            class="w-full aspect-square mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-body font-bold text-ink mt-12 mb-2 group-hover:text-ink/80 transition-colors">Look</h3>
        </a>
        <a href="#brand-personality" class="group">
          <img
            src={brandPersonalityImage.src}
            alt="Personality"
            class="w-full aspect-square mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-body font-bold text-ink mt-12 mb-2 group-hover:text-ink/80 transition-colors">
            Personality
          </h3>
        </a>
        <a href="#brand-influence" class="group">
          <img
            src={brandInfluenceImage.src}
            alt="Influence"
            class="w-full aspect-square mb-6 rounded-xl grayscale group-hover:grayscale-0 transition-all object-cover"
          />
          <h3 class="text-4xl font-body font-bold text-ink mt-12 mb-2 group-hover:text-ink/80 transition-colors">
            Influence
          </h3>
        </a>
      </div>
    </div>

    <!-- Brand Look Details -->
    <div id="brand-look" class="mb-20 scroll-mt-32">
      <div class="bg-white rounded-2xl mb-8 mx-6 overflow-hidden">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandLookImage.src}
              alt="Brand Look"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-body font-bold text-ink mb-2">Brand Look</h3>
            <p class="text-xl text-ink/80 mb-8">What people see.</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Brand Identity</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">Brand naming</li>
                    <li class="py-3 border-b border-grey text-ink">Logo design</li>
                    <li class="py-3 border-b border-grey text-ink">Brand guidelines</li>
                    <li class="py-3 border-b border-grey text-ink">VI design</li>
                    <li class="py-3 border-b border-grey text-ink">UI/UX design</li>
                    <li class="py-3 text-ink">IP design</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Visual Assets</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">Photography</li>
                    <li class="py-3 border-b border-grey text-ink">Video production</li>
                    <li class="py-3 border-b border-grey text-ink">3D animation</li>
                    <li class="py-3 border-b border-grey text-ink">Graphic design</li>
                    <li class="py-3 border-b border-grey text-ink">Web design</li>
                    <li class="py-3 text-ink">Packaging design</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Boton Case Study -->
      <div class="max-w-7xl mx-auto pt-48 px-6">
        <div class="grid md:grid-cols-2 gap-16 mb-8">
          <div class="md:col-span-1">
            <img
              src={botonCaseImage.src}
              alt="Boton Case Study"
              class="w-full h-auto rounded-2xl"
            />
          </div>
          <div class="md:col-span-1">
            <div class="mb-6">
              <img
                src={botonLogo.src}
                alt="Boton"
                class="h-20 w-auto mb-6"
              />
            </div>
            <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
              Name, logo & visual identity
            </h4>
            <p class="text-xl text-ink/80 mb-8 leading-relaxed">
              Boton is the first and largest Chinese listed company in the flavor
              and fragrance industry. We created the brand for a new vape brand
              the group was incubating. This included the brand naming, logo
              design, brand visuals, and brand guidelines.
            </p>
            <div>
              <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
              <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
                <li>Conduct a market research of the brand's industry</li>
                <li>Work with you to understand more about your brand</li>
                <li>Define the brand purpose, mission, vision, and values</li>
                <li>
                  Establish the brand positioning, audience, and competitors
                </li>
                <li>Create the brand's core message and storytelling</li>
                <li>Design three naming and logo design directions</li>
                <li>We sit down with you to analyze the directions</li>
                <li>
                  Based on the selected direction, we create three designs
                </li>
                <li>You select the final name and logo</li>
                <li>We make minor adjustments and create the VI design</li>
                <li>
                  With the brand visuals, we establish the brand guidelines
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Yadea Case Study -->
  <section class="bg-white py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
          <div class="md:col-span-1">
            <img
              src={yadeaCaseImage.src}
              alt="Yadea Case Study"
              class="w-full h-auto rounded-2xl"
            />
          </div>
          <div class="md:col-span-1">
            <div class="mb-6">
              <img
                src={yadeaLogo.src}
                alt="Yadea"
                class="h-20 w-auto mb-6"
              />
            </div>
            <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
              Video & photo production
            </h4>
            <p class="text-xl text-ink/80 mb-8 leading-relaxed">
              Yadea is the biggest electric bike producer in China and the second
              largest bike producer in the world. We produced a product video for
              the launch of their first electric kick scooter.
            </p>
            <div>
              <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
              <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
                <li>Creative video concept and storyboard</li>
                <li>
                  Full production team including production team, photography
                  team, lighting team, and props team
                </li>
                <li>Production teams in Milan and Shenzhen</li>
                <li>We can build props for specific requirements</li>
                <li>High resolution video shooting in 6K or 8K</li>
                <li>3D animation to showcase details of your products</li>
                <li>International actors and models</li>
                <li>Professional voice over actors</li>
              </ul>
            </div>
          </div>
        </div>
  </section>

  <!-- Brand Personality Details -->
  <section id="services" class="pt-60 pb-24 px-6 bg-brand">
    <div class="max-w-7xl mx-auto">
      <div id="brand-personality" class="mb-20 scroll-mt-32">
        <div class="bg-white rounded-2xl mb-8 mx-6 overflow-hidden">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandPersonalityImage.src}
              alt="Brand Personality"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-body font-bold text-ink mb-2">
              Brand Personality
            </h3>
            <p class="text-xl text-ink/80 mb-8">What people feel.</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Communication</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">Brand story</li>
                    <li class="py-3 border-b border-grey text-ink">Brand persona</li>
                    <li class="py-3 border-b border-grey text-ink">Social media management</li>
                    <li class="py-3 border-b border-grey text-ink">Copywriting</li>
                    <li class="py-3 text-ink">Campaign strategy</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Engagement</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">Service strategy</li>
                    <li class="py-3 border-b border-grey text-ink">Community management</li>
                    <li class="py-3 border-b border-grey text-ink">Customer care</li>
                    <li class="py-3 border-b border-grey text-ink">After-sales service</li>
                    <li class="py-3 text-ink">Media engagement</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Muzen Audio Case Study -->
  <section class="bg-white py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={muzenCaseImage.src}
          alt="Muzen Audio Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <div class="mb-6">
          <img
            src={muzenLogo.src}
            alt="Muzen Audio"
            class="h-20 w-auto mb-6"
          />
        </div>
        <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
          Miniature video & photo production
        </h4>
        <p class="text-xl text-ink/80 mb-8 leading-relaxed">
          Muzen Audio is a fashionable retro-looking portable speaker brand.
          We worked on many brand photography projects that leverage our
          expertise in miniature set creation. Just like how Muzen dabbles in
          different themes for their product designs, we also recreate the
          corresponding fantastical scenes through our diorama sets.
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
          <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
            <li>Creative photography concepts</li>
            <li>Hand craft miniature sets from scratch</li>
            <li>Create miniature props with attention to fine details</li>
            <li>
              Photography using diorama sets to produce photos that look
              more realistic than 3D renders
            </li>
            <li>
              Ensure a visual style that adheres to both the brand and
              campaign looks
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mead Johnson Case Study -->
  <section class="bg-brand py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={meadjohnsonCaseImage.src}
          alt="Mead Johnson Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <div class="mb-6">
          <img
            src={meadjohnsonLogo.src}
            alt="Mead Johnson"
            class="h-20 w-auto mb-6"
          />
        </div>
        <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
          Brand photography
        </h4>
        <p class="text-xl text-ink/80 mb-8 leading-relaxed">
          Mead Johnson is the leading infant formula brand in the world. We
          created high resolution brand photography of their baby formula
          product line for use in billboards the Chinese market.
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
          <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
            <li>Creative photography concepts based on brand guidelines</li>
            <li>Finalise the art direction of the photoshoot</li>
            <li>Shortlist and select models that suit the brand image</li>
            <li>Create the styling for makeup and costume</li>
            <li>Plan the props required to create the set</li>
            <li>
              Photography & post-processing to deliver high quality images
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

    <!-- Brand Influence Details -->
    <section id="services" class="pt-60 pb-24 px-6 bg-brand">
      <div class="max-w-7xl mx-auto">
        <div id="brand-influence" class="mb-20 scroll-mt-32">
          <div class="bg-white rounded-2xl mb-8 mx-6 overflow-hidden">
        <div class="grid md:grid-cols-3 gap-0">
          <div class="md:col-span-1">
            <img
              src={brandInfluenceImage.src}
              alt="Brand Influence"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="md:col-span-2 p-8 md:p-12">
            <h3 class="text-4xl font-body font-bold text-ink mb-2">
              Brand Influence
            </h3>
            <p class="text-xl text-ink/80 mb-8">What people say.</p>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Online marketing</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">SEO & SEM</li>
                    <li class="py-3 border-b border-grey text-ink">Social media marketing</li>
                    <li class="py-3 border-b border-grey text-ink">Email marketing</li>
                    <li class="py-3 border-b border-grey text-ink">Ads management</li>
                    <li class="py-3 text-ink">Crowdfunding</li>
                  </ul>
                </div>
              </div>
              <div class="border border-ink rounded-2xl overflow-hidden">
                <div class="bg-ink px-6 py-4">
                  <h4 class="text-xl font-heading uppercase font-semibold text-white text-center">Public relations</h4>
                </div>
                <div class="bg-white px-6 py-4">
                  <ul class="space-y-0">
                    <li class="py-3 border-b border-grey text-ink">KOL articles</li>
                    <li class="py-3 border-b border-grey text-ink">Authoritative articles</li>
                    <li class="py-3 border-b border-grey text-ink">Brand ambassadors</li>
                    <li class="py-3 border-b border-grey text-ink">Influencer marketing</li>
                    <li class="py-3 text-ink">Press releases</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Yeelight Case Study -->
  <section class="bg-brand py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={yeelightCaseImage.src}
          alt="Yeelight Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <div class="mb-6">
          <img
            src={yeelightLogo.src}
            alt="Yeelight"
            class="h-20 w-auto mb-6"
          />
        </div>
        <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
          Influencer marketing & PR
        </h4>
        <p class="text-xl text-ink/80 mb-8 leading-relaxed">
          Yeelight is the world's leading smart lighting brand from the Xiaomi
          ecosystem. We support Yeelight in campaigns to showcase their
          product launch by partnering with influencers in the smart home
          niche.
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
          <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
            <li>Reach out to our pool of key opinion leaders (KOLs)</li>
            <li>Check their audience demographic to match the outcome</li>
            <li>
              Review the interest and negotiate the collaboration rates
            </li>
            <li>Confirm the partnership and ship the products</li>
            <li>Prepare and communicate the content creation guidelines</li>
            <li>Check the content draft and approve to go live</li>
            <li>Collect the exposure and engagement data</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Kranio Case Study -->
  <section class="bg-white py-48">
    <div class="grid md:grid-cols-2 gap-16 mb-8 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="md:col-span-1">
        <img
          src={kranioCaseImage.src}
          alt="Kranio Case Study"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="md:col-span-1">
        <h4 class="text-3xl font-body font-bold text-ink uppercase mb-6">
          Crowdfunding
        </h4>
        <p class="text-xl text-ink/80 mb-8 leading-relaxed">
          Kranio is a limited-edition handcrafted speaker created by designer
          Alan Wong. We ran a Kickstarter campaign to help Alan bring his
          passion project to life with a limited budget. The product was
          showcased on Unbox Therapy and the video reached a million views
          within 24 hours. Crowdfunding campaigns generally cover all our
          service offerings.
        </p>
        <div>
          <p class="text-xl font-semibold text-ink mb-6">Work that we do:</p>
          <ul class="space-y-3 text-xl text-ink/80 leading-relaxed list-disc list-inside">
            <li>Market research to understand the target audience</li>
            <li>Provide brand and pricing positioning advice</li>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getCollection } from "astro:content";
---

<BaseLayout title="Blog - CheeseFlow 芝士溪谷">
  <Header />

  <!-- Blog Content -->
  <main class="pt-32">
    <section class="py-48 px-6 bg-white">
      <div class="max-w-7xl mx-auto">
        <h1
          class="max-w-3xl text-6xl md:text-7xl font-body font-bold text-ink mb-8"
        >
          Improve your brand with creative ideas.
        </h1>
        <p class="text-xl text-ink/80 mb-12">
          Coming soon. Check back for insights on branding, creativity, and
          strategy.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>



{
  "name": "cheeseflow-astro",
  "version": "1.0.0",
  "description": "CheeseFlow website built with Astro and Tailwind",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "pnpm run dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf .astro dist",
    "dev:clean": "pnpm run clean && pnpm run dev",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name=cheeseflow"
  },
  "packageManager": "pnpm@10.20.0",
  "keywords": [
    "astro",
    "tailwind",
    "cheeseflow"
  ],
  "author": "CheeseFlow",
  "license": "ISC",
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.15.5",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@tailwindcss/typography": "^0.5.19",
    "fast-xml-parser": "^5.3.2",
    "gray-matter": "^4.0.3",
    "rehype": "^13.0.2",
    "remark-images": "^4.1.0",
    "turndown": "^7.2.2",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "wrangler": "^4.51.0"
  }
}
